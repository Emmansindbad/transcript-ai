# Azure AD App Registration (Application permissions, admin-consented)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional ceiling — only tries this model and lower tiers (best-first order).
# Unset starts at gemini-3.8-flash, then gemini-3.6-flash.
# gemini-3.1-pro-preview tries Pro first. gemini-3.6-flash skips 3.8.
# Rate limits still apply; paid Gemini billing raises quota.
# GEMINI_MODEL=gemini-3.8-flash

# Target M365 user (UPN or object ID) whose calendar/transcripts to fetch.
# This account is also used as the email sender. Requires Mail.Send permission.
# Optional "Analyze recording video" feature additionally needs
# OnlineMeetingRecording.Read.All. Chat comparison needs Chat.Read.All and
# ChatMessage.Read.All. Microsoft To Do export needs Tasks.ReadWrite.All.
TARGET_USER_ID=

# Email address that receives the action items summary email.
# Defaults to mom@sindbad.tech if not set.
SUMMARY_EMAIL_RECIPIENT=mom@sindbad.tech

# "Send to Assignee" posts a Teams chat as a signed-in user (delegated).
# In the Entra app registration, Authentication → Add a platform → Web:
#   http://localhost:3000/api/auth/teams/callback
# Delegated permissions (admin consent): Chat.Create, ChatMessage.Send, User.Read.

# PMT ticket creation. The token is created on the PMT server with
# php artisan pmt:integration-token and must stay server-side.
PMT_BASE_URL=https://pmt.sindbad.tech
PMT_API_TOKEN=
